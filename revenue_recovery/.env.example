# Copy this file to a new file named ".env" (same folder), then fill
# in your real values below. The real .env file should NEVER be
# committed to GitHub or shared publicly -- it's already excluded via
# .gitignore in this project.

# From: Razorpay Dashboard -> Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# From: Razorpay Dashboard -> Settings -> Webhooks -> (your webhook) -> Secret
# Leave this blank until you've created the webhook in step 6 of the
# setup instructions at the top of webhook_app.py.
RAZORPAY_WEBHOOK_SECRET=

# Optional. Your current tunnel's public URL (e.g. https://xxxx.trycloudflare.com).
# Only needed so ESCALATED (attempt 2) reminder links also route through
# the click-tracking redirect -- attempt 1 always tracks clicks correctly
# regardless of this, since it runs inside a real HTTP request and can
# read the URL directly. Update this if your tunnel URL changes mid-session.
PUBLIC_BASE_URL=

# Optional. Enables the LLM diagnosis fallback (pipeline/llm_diagnosis.py)
# and AI-personalized recovery messages (pipeline/llm_messaging.py).
# Uses Google's Gemini API -- get a genuinely free key (no credit card,
# no expiration) at https://aistudio.google.com/apikey. Without this,
# both features fall back gracefully to rule-based diagnosis and static
# message templates -- nothing breaks, you just won't see "AI" badges
# on the dashboard.
GEMINI_API_KEY=
